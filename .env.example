# SurgiSight environment configuration — copy to .env and fill in values

# Database (PostgreSQL for production, SQLite for dev/tests)
DATABASE_URL=postgresql+psycopg://surgisight:CHANGE_ME@localhost:5432/surgisight
# For SQLite dev: DATABASE_URL=sqlite+aiosqlite:///./surgisight_dev.db

# CORS — comma-separated list of allowed origins (no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT — use a 32+ byte random secret in production
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32_BYTE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
# Set true when served over HTTPS; false is for localhost development only.
REFRESH_COOKIE_SECURE=false

# Storage directory (relative to repo root, git-ignored)
STORAGE_DIR=storage

# Upload size cap in MB
MAX_UPLOAD_SIZE_MB=2048

# Feature flags (set to true when real model artifacts are available)
USE_REAL_M2=false
USE_REAL_M3=false
USE_REAL_M4=false

# Test-only: allow synthetic artifacts (never true in production)
ALLOW_SYNTHETIC_ARTIFACT=false
